# Copy this file to .env (never commit .env itself) and fill in real values
# once you have them. See docs/02-discord-bots-setup.md and
# docs/03-provider-api-keys.md for where each of these comes from.

# --- Model providers ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# --- Discord bot tokens (one per agent) ---
DISCORD_CORE_BOT_TOKEN=
DISCORD_FINANCE_BOT_TOKEN=
DISCORD_PICTURE_BOT_TOKEN=
DISCORD_CODING_BOT_TOKEN=
DISCORD_FILE_BOT_TOKEN=
DISCORD_MARKETING_BOT_TOKEN=
DISCORD_RESEARCH_BOT_TOKEN=

# --- Discord company server ---
DISCORD_SERVER_GUILD_ID=
