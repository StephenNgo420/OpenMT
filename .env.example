# Copy this file to .env (never commit .env itself) and fill in real values
# once you have them. See docs/02-telegram-bots-setup.md and
# docs/03-provider-api-keys.md for where each of these comes from.

# --- Model providers ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# --- Telegram bot tokens (one per agent) ---
TELEGRAM_CORE_BOT_TOKEN=
TELEGRAM_FINANCE_BOT_TOKEN=
TELEGRAM_PICTURE_BOT_TOKEN=
TELEGRAM_CODING_BOT_TOKEN=
TELEGRAM_FILE_BOT_TOKEN=
TELEGRAM_MARKETING_BOT_TOKEN=
TELEGRAM_RESEARCH_BOT_TOKEN=

# --- Telegram company group ---
TELEGRAM_COMPANY_GROUP_CHAT_ID=
