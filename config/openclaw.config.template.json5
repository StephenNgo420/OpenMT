// openclaw.config.template.json5
//
// WHAT THIS FILE IS: a template for the parts of ~/.openclaw/openclaw.json
// that define our seven-agent company. It is NOT itself the live config —
// it's checked into git, so it must never contain a real token or API key.
//
// HOW IT'S USED (Stage 3, once you have bots + keys):
// you'll merge the "agents" and "channels.discord" blocks below into your
// real ~/.openclaw/openclaw.json, replacing every ${PLACEHOLDER} with a
// real secret. We'll do that step together rather than you guessing at it.
//
// PLATFORM NOTE: this project runs on Discord, not Telegram (switched
// before any Telegram-specific work was actually done, so nothing was
// wasted). See docs/02-discord-bots-setup.md.
//
// WHY MODEL / AGENT / RESPONSIBILITY ARE KEPT SEPARATE: notice that an
// agent's *id* (e.g. "finance") never changes, its *model* is just a
// config value under agents.entries.finance.model, and its
// *responsibility* lives in agents/finance/AGENTS.md as plain text, not
// code. Swapping FinanceBot from Claude to another model later is a
// one-line config edit here — nothing about "what FinanceBot is allowed to
// do" has to change.
//
// VERSION NOTE: this template uses the `agents.entries.<id>` shape
// documented for current OpenClaw releases. Before merging this on your
// server, run `openclaw --version` and `openclaw config get agents` and
// tell me what comes back — if your installed version uses a different
// key name (some docs show `agents.list`), we'll adjust this file to match
// rather than assuming.

{
  agents: {
    defaults: {
      // Fallback used only if a specific agent entry below doesn't
      // override it. Kept intentionally generic.
      subagents: {
        // Only entries explicitly listed in an agent's own
        // "subagents.allowAgents" may be sessions_spawn-targeted by it.
        // This is how we enforce "specialists don't freely commission
        // each other" (project rule 15) at the OpenClaw config level,
        // not just in prose.
        requireAgentId: true,
      },
    },

    entries: {
      core: {
        // Balanced posture (your choice): ROUTER stays on the cheap tier,
        // everything else on the mid tier — see
        // docs/04-cost-and-token-discipline.md#default-posture-balanced.
        // TODO(stage 3): confirm current OpenAI tier model ids when we
        // wire real keys — not hardcoding a guess that may be stale.
        model: {
          // DIRECT_SPECIALIST + FALLBACK_EXECUTOR tier: mid tier.
          primary: "openai:<mid-tier-todo>", // ChatGPT family, per roster
          // ROUTER tier: intent classification + structured task-packet
          // writing is closer to formatting than deep reasoning, so it
          // runs on the cheap tier in the same family.
          router: "openai:<cheap-tier-todo>",
        },
        // Real observed path on our server (confirmed live, not guessed):
        // ~/.openclaw/workspace/<id> — not agents/<id>/workspace as
        // earlier drafts of this file assumed.
        workspace: "~/.openclaw/workspace/core",
        subagents: {
          // CoreBot is the only agent allowed to spawn every specialist.
          allowAgents: ["finance", "picture", "coding", "file", "marketing", "research"],
          delegationMode: "prefer", // push non-trivial work through sessions_spawn rather than answering directly
        },
        // Static system-prompt content (SOUL.md + AGENTS.md) should be
        // marked cacheable once we wire this up in Stage 4, so repeat
        // calls in the same session don't re-bill the full input tokens
        // for personas that never change mid-session.
      },

      finance: {
        // Balanced posture: mid-tier Claude model, not the top tier.
        // TODO(stage 3): confirm current mid-tier Anthropic model id.
        model: { primary: "anthropic:<mid-tier-todo>" },
        workspace: "~/.openclaw/workspace/finance",
        subagents: {
          // FinanceBot may only hand off to FileBot (packaging), per its AGENTS.md.
          allowAgents: ["file"],
        },
      },

      picture: {
        // Balanced posture: mid-tier Gemini model.
        // TODO(stage 3): confirm current mid-tier Google model id — image
        // generation/editing may only be available on specific model ids,
        // so this one needs a deliberate check rather than a guess.
        model: { primary: "google:<mid-tier-todo>" },
        workspace: "~/.openclaw/workspace/picture",
        subagents: { allowAgents: [] }, // receives handoffs, doesn't initiate any
      },

      coding: {
        // Balanced posture: mid-tier Claude model by default. CodingBot's
        // internal-systems-engineer work (self-change, §42-48) may
        // warrant escalating to the top tier on a case-by-case basis —
        // that's a deliberate escalation, not the default.
        // TODO(stage 3): confirm current mid-tier Anthropic model id.
        model: { primary: "anthropic:<mid-tier-todo>" },
        workspace: "~/.openclaw/workspace/coding",
        subagents: { allowAgents: [] }, // routes cross-specialist needs back through core
      },

      file: {
        // Balanced posture: mid-tier Claude model.
        // TODO(stage 3): confirm current mid-tier Anthropic model id.
        model: { primary: "anthropic:<mid-tier-todo>" },
        workspace: "~/.openclaw/workspace/file",
        subagents: { allowAgents: [] },
      },

      marketing: {
        // Balanced posture: mid-tier Gemini model.
        // TODO(stage 3): confirm current mid-tier Google model id.
        model: { primary: "google:<mid-tier-todo>" },
        workspace: "~/.openclaw/workspace/marketing",
        subagents: {
          // MarBot's only permitted outbound handoff is to PictureBot.
          allowAgents: ["picture"],
        },
      },

      research: {
        // Balanced posture: mid-tier Gemini model.
        // TODO(stage 3): confirm current mid-tier Google model id.
        model: { primary: "google:<mid-tier-todo>" },
        workspace: "~/.openclaw/workspace/research",
        subagents: { allowAgents: [] },
      },
    },
  },

  channels: {
    discord: {
      accounts: {
        // One Discord bot (application) per agent, per project rule 3/11.
        // Discord's field is "token", not "botToken" like Telegram's —
        // confirmed against current OpenClaw docs, not assumed from the
        // Telegram shape. Replace each token with the real value from the
        // Discord Developer Portal — in your REAL ~/.openclaw/openclaw.json
        // only, never here.
        //
        // "guilds" names which Discord server(s) each bot is allowed to
        // operate in — Discord requires this explicitly (Telegram didn't).
        // ${DISCORD_SERVER_GUILD_ID} is the same one server ID for all 7,
        // once the company server exists.
        core: {
          enabled: true,
          token: "${DISCORD_CORE_BOT_TOKEN}",
          guilds: { "${DISCORD_SERVER_GUILD_ID}": {} },
        },
        finance: {
          enabled: true,
          token: "${DISCORD_FINANCE_BOT_TOKEN}",
          guilds: { "${DISCORD_SERVER_GUILD_ID}": {} },
        },
        picture: {
          enabled: true,
          token: "${DISCORD_PICTURE_BOT_TOKEN}",
          guilds: { "${DISCORD_SERVER_GUILD_ID}": {} },
        },
        coding: {
          enabled: true,
          token: "${DISCORD_CODING_BOT_TOKEN}",
          guilds: { "${DISCORD_SERVER_GUILD_ID}": {} },
        },
        file: {
          enabled: true,
          token: "${DISCORD_FILE_BOT_TOKEN}",
          guilds: { "${DISCORD_SERVER_GUILD_ID}": {} },
        },
        marketing: {
          enabled: true,
          token: "${DISCORD_MARKETING_BOT_TOKEN}",
          guilds: { "${DISCORD_SERVER_GUILD_ID}": {} },
        },
        research: {
          enabled: true,
          token: "${DISCORD_RESEARCH_BOT_TOKEN}",
          guilds: { "${DISCORD_SERVER_GUILD_ID}": {} },
        },
      },
      // Fine-grained bindings (which account -> which agent, which
      // channel(s) it watches) get finalized in Stage 3 once the real
      // Discord server + bots exist. Left out here deliberately rather
      // than guessed.
    },
  },
}
