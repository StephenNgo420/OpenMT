// openclaw.config.template.json5
//
// WHAT THIS FILE IS: a template for the parts of ~/.openclaw/openclaw.json
// that define our seven-agent company. It is NOT itself the live config —
// it's checked into git, so it must never contain a real token or API key.
//
// STATUS: Stage 3 (bind each agent to its own Discord bot) is DONE on the
// real server, confirmed working end-to-end for all 7 agents. This file
// has been corrected to match what's actually running, based on live
// `openclaw config get` output and a lot of hands-on debugging — not
// re-guessed from docs. See "CONFIRMED VS UNVALIDATED" below for what's
// still speculative.
//
// PLATFORM: Discord (switched from an original Telegram plan before any
// Telegram-specific work existed). See docs/02-discord-bots-setup.md.

{
  // ---------------------------------------------------------------------
  // AGENTS — confirmed shape: a top-level "list" ARRAY, each item keyed by
  // "id" (not an "entries" object keyed by id, as earlier drafts of this
  // file assumed — corrected after `openclaw config get agents` on the
  // real server). "model" is a plain "provider/model-id" STRING per agent,
  // not a nested {primary, router} object — that tiering idea (routing
  // requests to a cheaper model for classification vs. a stronger one for
  // real work, see docs/04-cost-and-token-discipline.md) was a Stage-4
  // design intent that has NOT been validated against the real schema.
  // Whether/how per-mode model tiering is actually achievable is an open
  // question for Stage 4, not something this file should claim works.
  // ---------------------------------------------------------------------
  agents: {
    list: [
      {
        id: "core",
        model: "openai/<model-id>", // ChatGPT family, per roster. Confirm current tier/id at setup time.
        workspace: "~/.openclaw/workspace/core",
        // subagents.allowAgents (delegation graph) is UNVALIDATED design
        // intent for Stage 4 — never actually applied via `config patch`
        // on the real server, so don't assume this field name/shape is
        // correct until Stage 4 testing confirms it.
        // subagents: { allowAgents: ["finance", "picture", "coding", "file", "marketing", "research"] },
      },
      { id: "finance",   model: "anthropic/<model-id>", workspace: "~/.openclaw/workspace/finance" },
      { id: "picture",   model: "google/<model-id>",    workspace: "~/.openclaw/workspace/picture" },
      { id: "coding",    model: "anthropic/<model-id>", workspace: "~/.openclaw/workspace/coding" },
      { id: "file",      model: "anthropic/<model-id>", workspace: "~/.openclaw/workspace/file" },
      { id: "marketing", model: "google/<model-id>",    workspace: "~/.openclaw/workspace/marketing" },
      { id: "research",  model: "google/<model-id>",    workspace: "~/.openclaw/workspace/research" },
    ],
  },

  // ---------------------------------------------------------------------
  // PLUGINS — required, confirmed live. Without this, the gateway logs
  // "external plugin discord is installed without explicit trust" and
  // (in our case) the plugin still partly worked but this is the correct,
  // intended way to enable it rather than relying on auto-load.
  // ---------------------------------------------------------------------
  plugins: {
    entries: {
      discord: { enabled: true },
    },
  },

  // ---------------------------------------------------------------------
  // TOOLS — required, confirmed live. Without "group:messaging" here,
  // agents can receive Discord messages but cannot reply, upload files,
  // or react — they fail completely silently (no error, no log, nothing)
  // which cost significant time to diagnose. `alsoAllow` ADDS to the
  // default tool set rather than replacing it (unlike the stricter
  // `allow` field) — confirmed by reading the schema before using it.
  // ---------------------------------------------------------------------
  tools: {
    alsoAllow: ["group:messaging"],
  },

  // ---------------------------------------------------------------------
  // CHANNELS — Discord. One bot (application) per agent, per project
  // rule 3/11. Confirmed field names: "token" (not "botToken" like
  // Telegram), and "guilds" keyed by the numeric Discord guild/server ID.
  //
  // THE PART THAT COST THE MOST TIME TO FIND: an account's "guilds" entry
  // is not optional decoration — without registering the guild ID here,
  // the bot connects, shows online, and Discord's own transport layer
  // even registers inbound messages ("in: Xm ago" in `channels status`),
  // but the message is silently NEVER routed to the agent — no session
  // is ever created, no error anywhere. Registering the guild ID (even
  // as an empty {} — no further per-channel config required to get a
  // basic response working) was the actual fix.
  // ---------------------------------------------------------------------
  channels: {
    discord: {
      accounts: {
        core:      { enabled: true, token: "${DISCORD_CORE_BOT_TOKEN}",      guilds: { "${DISCORD_SERVER_GUILD_ID}": {} } },
        finance:   { enabled: true, token: "${DISCORD_FINANCE_BOT_TOKEN}",   guilds: { "${DISCORD_SERVER_GUILD_ID}": {} } },
        picture:   { enabled: true, token: "${DISCORD_PICTURE_BOT_TOKEN}",   guilds: { "${DISCORD_SERVER_GUILD_ID}": {} } },
        coding:    { enabled: true, token: "${DISCORD_CODING_BOT_TOKEN}",    guilds: { "${DISCORD_SERVER_GUILD_ID}": {} } },
        file:      { enabled: true, token: "${DISCORD_FILE_BOT_TOKEN}",      guilds: { "${DISCORD_SERVER_GUILD_ID}": {} } },
        marketing: { enabled: true, token: "${DISCORD_MARKETING_BOT_TOKEN}", guilds: { "${DISCORD_SERVER_GUILD_ID}": {} } },
        research:  { enabled: true, token: "${DISCORD_RESEARCH_BOT_TOKEN}", guilds: { "${DISCORD_SERVER_GUILD_ID}": {} } },
      },
      // Routing bindings (which Discord account belongs to which agent)
      // are NOT hand-authored JSON here — they're applied with:
      //   openclaw agents bind --agent <id> --bind discord:<id>
      // which writes its own config section we haven't fully mapped out
      // (confirmed to work via the CLI; the exact JSON it produces is an
      // implementation detail we didn't need to reverse-engineer).
    },
  },
}
